{
  "name": "lanzarote-3d",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "dependencies": {
    "ajv": "^8.17.1",
    "lil-gui": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-loader": "^9.2.1",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^24.1.3",
    "prettier": "^3.6.2",
    "source-map-loader": "^4.0.2",
    "style-loader": "^3.3.4",
    "stylus": "^0.64.0",
    "stylus-loader": "^7.1.3",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "scripts": {
    "clean": "rm -R dist || true",
    "start": "webpack serve --mode development --open --hot",
    "dev": "yarn start",
    "build": "webpack --mode production",
    "build-all": "webpack --mode production",
    "pre-deploy": "yarn lint:check && yarn format:check",
    "build-staging": "yarn clean && yarn pre-deploy && yarn build-all",
    "delete-staging": "aws s3 rm s3://lanzarote3d --recursive --profile lanzaroteparagliding",
    "deploy-staging": "yarn build-staging && yarn tag-staging && yarn delete-staging && yarn upload-staging",
    "upload-staging": "aws s3 cp dist s3://lanzarote3d --recursive --profile lanzaroteparagliding",
    "tag-staging": "git tag STAGING-$(date '+%F_%H%M')",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint src/**/*.{ts,tsx} --fix",
    "lint:check": "eslint src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx,css}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css}",
    "type-check": "tsc --noEmit",
    "delete-flyzones": "aws s3 rm s3://lanzarote-flyzones-eu --recursive --profile lanzaroteparagliding",
    "upload-flyzones": "aws s3 cp dist s3://lanzarote-flyzones-eu --recursive --profile lanzaroteparagliding",
    "build-flyzones": "yarn clean && yarn pre-deploy && webpack --config webpack.flyzones.js --mode production",
    "deploy-flyzones": "yarn build-flyzones && yarn tag-flyzones && yarn delete-flyzones && yarn upload-flyzones",
    "tag-flyzones": "git tag FLYZONES-$(date '+%F_%H%M')",
    "delete-showcase": "aws s3 rm s3://lanzaroteparagliding-placeholder --recursive --profile lanzaroteparagliding",
    "upload-showcase": "aws s3 cp dist s3://lanzaroteparagliding-placeholder --recursive --profile lanzaroteparagliding",
    "build-showcase": "yarn clean && yarn pre-deploy && webpack --config webpack.showcase.js --mode production",
    "run-showcase": "yarn build-showcase && npx serve dist -p 8080",
    "deploy-showcase": "yarn build-showcase && yarn tag-showcase && yarn delete-showcase && yarn upload-showcase && yarn invalidate-prod-cache",
    "tag-showcase": "git tag PLACEHOLDER-$(date '+%F_%H%M')",
    "invalidate-prod-cache": "aws cloudfront create-invalidation --distribution-id E8276RQ1W5RSC --paths '/*' --profile lanzaroteparagliding"
  },
  "types": "index.d.ts",
  "author": "ivan l.",
  "license": "UNLICENSED",
  "private": true
}
