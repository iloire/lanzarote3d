    "webpack": "^5.101.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "scripts": {
    "clean": "rm -R dist || true",
    "start": "webpack serve --mode development --open --hot",
    "dev": "yarn start",
    "build": "webpack --mode production",
    "pre-build": "yarn lint:check && yarn format:check",
    "pre-deploy": "yarn lint:check && yarn format:check",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint src/**/*.{ts,tsx} --fix",
    "lint:check": "eslint src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx,css}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css}",
    "type-check": "tsc --noEmit",
    "delete-prod": "aws s3 rm s3://lanzaroteparagliding-placeholder --recursive --profile lanzaroteparagliding",
    "upload-prod": "aws s3 cp dist s3://lanzaroteparagliding-placeholder --recursive --profile lanzaroteparagliding",
    "run-prod": "yarn build && npx serve dist -p 8080",
    "deploy-prod": "yarn build && yarn tag-prod && yarn delete-prod && yarn upload-prod && yarn invalidate-prod-cache",
    "tag-prod": "git tag PROD-$(date '+%F_%H%M')",
    "invalidate-prod-cache": "aws cloudfront create-invalidation --distribution-id E8276RQ1W5RSC --paths '/*' --profile lanzaroteparagliding"
  },
  "types": "index.d.ts",
  "author": "ivan l.",
  "license": "UNLICENSED",
  "private": true
